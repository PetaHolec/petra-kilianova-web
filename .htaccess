# Adresy bez .html: /slovnicek ukáže slovnicek.html, stará adresa se přesměruje.
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^ / [R=301,L]

# /slovnicek.html -> /slovnicek (dotaz za otazníkem zůstává)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# /slovnicek/ -> /slovnicek
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /slovnicek zobrazí soubor slovnicek.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]
